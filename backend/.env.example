# Database settings are required by the backend.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=riskadjustment
DB_USER=postgres
DB_PASSWORD=change-me

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Set these to true and none when the deployed frontend and API are cross-site HTTPS origins.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax